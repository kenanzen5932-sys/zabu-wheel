/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' https: blob: data:; worker-src 'self' blob:; frame-ancestors 'none'

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/zabu-bridge.js
  Cache-Control: no-cache

/application.66948.js
  Cache-Control: public, max-age=86400

/index.90933.js
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/src/*
  Cache-Control: public, max-age=31536000, immutable

/game/*
  Cache-Control: public, max-age=31536000, immutable
